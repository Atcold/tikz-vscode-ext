// Settings for tikz-vscode-ext, to merge into your VS Code user settings.json.
//
// Nothing here names a theme. The grammar maps TikZ onto conventional TextMate scopes,
// so an option key is coloured like an HTML attribute, a dimension like a numeric
// literal, a path operator like a keyword — switch themes and the TikZ highlighting
// follows, with no palette to maintain.

{
  // ---------------------------------------------------------------------------------
  // REQUIRED. Without this the \def and style highlighting is computed and discarded.
  //
  // A theme opts into semantic highlighting with a "semanticHighlighting": true flag in
  // its own JSON, and many omit or disable it. Setting this at the top level, with no
  // "[Theme Name]" key, forces it on for every theme you use now or later.
  // ---------------------------------------------------------------------------------
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,

    // Font weight for the two semantic token types. These come from the provider, not
    // the grammar, so textMateRules cannot reach them -- they have to be styled here.
    // Only fontStyle is given, so each theme keeps its own colours, and "" is again
    // what means plain.
    "rules": {
      "tikzMacro": { "fontStyle": "" },
      "tikzStyle": { "fontStyle": "" }
    }
  },

  // ---------------------------------------------------------------------------------
  // OPTIONAL. Delete this whole block if you would rather stay purely theme-driven.
  //
  // The maths rules below are not optional if you dislike bold maths; the punctuation
  // colours at the end are. Most themes leave punctuation at the default foreground, so
  // the three kinds of delimiter end up correctly *scoped* but not visibly distinct.
  // Those greys are the only literal colours in the project.
  //
  // Note the shape: textMateRules goes at the TOP LEVEL, which is what applies to every
  // theme. A nested key is only read when it is a theme scope in square brackets, like
  // "[Aether Neptune]". Anything else -- "*" included -- is silently ignored.
  // ---------------------------------------------------------------------------------
  "editor.tokenColorCustomizations": {
    "textMateRules": [
        // -----------------------------------------------------------------------------
        // Font weight. Only fontStyle is set, never a foreground, so the theme keeps its
        // colours and these rules survive a theme change.
        //
        // An empty string is required to clear bold. Omitting the key means "inherit
        // from the theme", which changes nothing -- "" is what means "plain".
        // -----------------------------------------------------------------------------
        {
          "name": "LaTeX: maths delimiters \\( \\) and $ $ are not bold",
          "scope": [
            "support.class.math.block.environment.latex",
            "support.class.math.block.tex"
          ],
          "settings": { "fontStyle": "" }
        },
        {
          // Ancestor-qualified deliberately: support.function.general.tex is also \draw,
          // \node and \tikzset out in the picture, and those stay bold.
          "name": "LaTeX: control sequences inside maths are not bold",
          "scope": "meta.math.block support.function.general.tex",
          "settings": { "fontStyle": "" }
        },

        {
          "name": "TikZ: option brackets [ ]",
          "scope": [
            "punctuation.section.options.begin.tikz",
            "punctuation.section.options.end.tikz"
          ],
          "settings": { "foreground": "#e0a458" }
        },
        {
          "name": "TikZ: coordinate parentheses ( )",
          "scope": [
            "punctuation.section.coordinate.begin.tikz",
            "punctuation.section.coordinate.end.tikz"
          ],
          "settings": { "foreground": "#7bb0d6" }
        },
        {
          "name": "TikZ: value braces { }",
          "scope": [
            "punctuation.section.group.begin.tikz",
            "punctuation.section.group.end.tikz"
          ],
          "settings": { "foreground": "#9a8fbe" }
        },
        {
          "name": "TikZ: statement terminator ;",
          "scope": "punctuation.terminator.tikz",
          "settings": { "foreground": "#e05f5f", "fontStyle": "bold" }
        }
    ]
  }
}
